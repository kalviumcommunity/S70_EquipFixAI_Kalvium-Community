# EquipFixAI Environment Configuration

PROJECT_NAME=EquipFixAI
API_V1_STR=/api
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite:///./equipfixai.db
# DATABASE_URL=postgresql://equipfix_user:equipfix_pass@localhost:5432/equipfix_db

# AI / Embeddings Configuration
# Optional: OpenAI API Key for external LLM fallback. If blank, uses built-in industrial embeddings engine.
OPENAI_API_KEY=

# Port & Server Settings
PORT=8000
HOST=0.0.0.0
