# EquipFixAI Environment Configuration

# Backend Configuration
PROJECT_NAME=EquipFixAI
API_V1_STR=/api
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production / Docker Compose, SQLite for local standalone development)
DATABASE_URL=sqlite:///./backend/equipfixai.db
# DATABASE_URL=postgresql://equipfix_user:equipfix_pass@localhost:5432/equipfix_db

# External LLM / Embedding Key (Optional)
OPENAI_API_KEY=

# Server Ports
PORT=8000
FRONTEND_PORT=5173
